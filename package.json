{
  "name": "@tonycletus/app-icon-pipeline",
  "version": "0.1.0",
  "description": "Generate PWA, Apple, favicon, and Windows ICO app icons from one source image.",
  "type": "module",
  "license": "MIT",
  "author": "Tony Cletus",
  "homepage": "https://github.com/tonycletus/app-icon-pipeline#readme",
  "bugs": {
    "url": "https://github.com/tonycletus/app-icon-pipeline/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tonycletus/app-icon-pipeline.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "icons",
    "pwa",
    "ico",
    "favicon",
    "wails",
    "desktop"
  ],
  "bin": {
    "app-icon-pipeline": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "sharp": "^0.33.5"
  },
  "packageManager": "pnpm@10.17.0",
  "devDependencies": {
    "@types/node": "^22.16.5",
    "tsup": "^8.3.6",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
